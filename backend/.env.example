# Google Gemini API key (free tier: https://aistudio.google.com/apikey). Required for
# embeddings (ingestion + retrieval) and answer generation. Never commit the real value.
GEMINI_API_KEY=your-key-here

# PostgreSQL + pgvector connection. This value is for running backend commands on your host
# against `docker compose up -d db` (published on localhost:5433). Inside the `backend`
# container, docker-compose.yml overrides it to point at the `db` service instead.
DATABASE_URL=postgresql://pnw:pnw@localhost:5433/pnw_chatbot
